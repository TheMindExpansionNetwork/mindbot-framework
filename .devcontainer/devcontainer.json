{
  // GITHUB CODESPACES — a full MindBot in the browser, no local install.
  //
  // Open at: https://codespaces.new/TheMindExpansionNetwork/mindbot-framework
  //
  // Worth noting WHY this container is nearly empty: the core is Python 3.10+ standard library
  // only, so there is no dependency tree to install, pin, or audit. `pip install -e .` wires up
  // the `mindbot` command and nothing else. If this file ever grows a long list of packages,
  // that is a signal the core stopped being stdlib-only.
  //
  // A Codespace also runs Linux, which exercises the POSIX (fcntl) locking path that a Windows
  // machine never touches — see .github/workflows/nightly.yml for the scheduled version.
  "name": "MindBot",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Editable install so `mindbot` is on PATH, then prove the checkout is sound before the user
  // touches anything: doctor, full audit, and the self-report.
  "postCreateCommand": "cd framework && pip install -e . && python -m mindbot_pipeline.cli doctor && python _full_audit.py",
  "postAttachCommand": "cd framework && python -m mindbot_pipeline.cli whoami",

  // Mission Control. Not auto-opened: `mindbot start` is the documented entry point and the
  // first-run flow needs to ask for your own OpenRouter key.
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Mission Control", "onAutoForward": "notify" }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.testing.unittestEnabled": true,
        "python.testing.unittestArgs": ["-v", "-s", "framework/tests", "-p", "test_*.py"]
      }
    }
  },

  "remoteEnv": {
    // Ceilings stay ON in a cloud environment. A Codespace is exactly where an unbounded agent
    // would quietly run up a bill nobody is watching.
    "MINDBOT_BUDGET_OFF": "0"
  }
}
