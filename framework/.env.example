# M1NDB0TZ config — copy this to `.env` (same folder) and fill in what you use.
# `.env` is gitignored and NEVER committed. Keys live ONLY here. `mindbot doctor` checks them.
# You don't need all of it — pick a tier (see docs/MODEL_TIERS.md). The $0 path works with nothing set.

# ── Tier 2: OpenRouter (easiest — one key, every model) ──────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
MINDBOT_FREE=1            # 1 = use only FREE OpenRouter models ($0). Remove for paid/best quality.

# ── Tier 1: bring your own provider keys (optional) ──────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# XAI_API_KEY=xai-...
# GOOGLE_API_KEY=...
# DEEPSEEK_API_KEY=sk-...
# MISTRAL_API_KEY=...

# ── Tier 3a: local models (offline-capable) ──────────────────────────────────
# OLLAMA_HOST=http://localhost:11434
# LMSTUDIO_HOST=http://localhost:1234
# MINDBOT_LOCAL_MODEL=qwen3:8b        # fallback local model name

# ── Tier 3b: our own fleet on Modal (set after you deploy a pod) ──────────────
# MINDBOT_SONIC_URL=https://<ws>--sonic-diffusiongemma-serve.modal.run/v1   # S0N1C (diffusion)
# MINDBOT_CODER_URL=https://<ws>--podz-c0d3r-serve.modal.run/v1             # c0d3r (coding)
# MINDBOT_VOXX_URL=https://<ws>--voxx-kokoro-tts-web.modal.run              # v0x (voice)
# MINDBOT_SONIC_KEY=sonic            # optional bearer (vLLM ignores auth unless --api-key set)
# MINDBOT_CODER_KEY=coder

# ── Routing switches ─────────────────────────────────────────────────────────
# MINDBOT_SONIC_ALL=1     # route the WHOLE council to the fleet (a diffusion swarm)
# MINDBOT_NO_SONIC=1      # never touch the (billed) GPU fleet — the autonomous loop sets this to stay $0

# ── YOUR OWN MODAL ENDPOINT (optional) ────────────────────────────────────────
# A private inference server you host. Fixed cost against credits you already bought,
# so it is CHEAPER than metered OpenRouter — and it accepts IMAGES and AUDIO, which
# none of the text-only routing can use.
#
# AUTH: a *.modal.direct endpoint wants ONE header, dot-joined:
#     Authorization: Bearer wk-<id>.ws-<secret>
# It does NOT accept the Modal-Key / Modal-Secret header pair — those are for
# *.modal.run web endpoints. Sample code found online routinely gets this wrong.
# Run mindbot modal check — it tells you WHICH layer failed rather than just 401.
MODAL_ENDPOINT_URL=https://<app>--<fn>.<region>.modal.direct/v1
MODAL_PROXY_TOKEN_ID=wk-...
MODAL_PROXY_TOKEN_SECRET=ws-...
MODAL_MODEL=thinkingmachines/Inkling-NVFP4
# MINDBOT_MODAL=1   # opt IN to route the whole council through it
